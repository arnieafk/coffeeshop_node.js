<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Coffee Shop System" %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<!-- TOP HEADER -->
<header class="top-header">
  <div>☕ Coffee Shop System</div>

  <div>
    <% if (currentUser) { %>
      Welcome, <%= currentUser.name %> (<%= currentUser.role %>)
      <a href="/logout" class="logout-btn">Logout</a>
    <% } %>
  </div>
</header>

<div class="container">

  <!-- SIDEBAR (ROLE BASED) -->
  <nav class="sidebar">

    <h2>
      ☕ <%= currentUser.role.toUpperCase() %> PANEL
    </h2>

    <% if (currentUser.role === 'admin') { %>

      <p class="menu-title">MAIN</p>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/products">📦 Products</a>
      <a href="/admin/orders">📋 Orders</a>
      <a href="/admin/payments">💳 Payments</a>

    <% } %>

    <% if (currentUser.role === 'staff') { %>

      <p class="menu-title">MAIN</p>
      <a href="/staff">📊 Dashboard</a>
      <a href="/staff/orders">📋 Orders</a>

    <% } %>

    <% if (currentUser.role === 'customer') { %>

      <p class="menu-title">MAIN</p>
      <a href="/customer">🏠 Dashboard</a>
      <a href="/customer/menu">📖 Menu</a>
      <a href="/customer/cart">🛒 Cart</a>
      <a href="/customer/orders">📋 Orders</a>

    <% } %>

  </nav>

  <!-- MAIN CONTENT -->
  <main class="main">
    <%- body %>
  </main>

</div>

</body>
</html>