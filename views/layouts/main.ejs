<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title || "Coffee Shop System" %></title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header class="top-header">

  <div class="left-header">
    ☕ Coffee Shop System
  </div>

  <button class="menu-toggle" onclick="toggleSidebar()">☰</button>

  <div class="right-header">

    <% if (currentUser) { %>
      <span>
        Welcome, <%= currentUser.name %>
        (<%= currentUser.role %>)
      </span>

      <a href="/logout" class="logout-btn">Logout</a>

    <% } else { %>
      <a href="/login" class="logout-btn">Login</a>
    <% } %>

  </div>

</header>

<div class="container">

  <nav class="sidebar" id="sidebar">

    <h2>
      <%= currentUser?.role ? currentUser.role.toUpperCase() + " PANEL" : "PANEL" %>
    </h2>

    <% if (currentUser && currentUser.role === 'admin') { %>

      <p class="menu-title">MAIN</p>

      <a href="/admin/products"
         class="<%= currentPath.startsWith('/admin/products') ? 'active' : '' %>">
        Products
      </a>

      <a href="/admin/orders"
         class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>">
        Orders
      </a>

      <a href="/admin/payments"
         class="<%= currentPath.startsWith('/admin/payments') ? 'active' : '' %>">
        Payments
      </a>

    <% } %>

    <% if (currentUser && currentUser.role === 'staff') { %>

      <p class="menu-title">MAIN</p>

      <a href="/staff"
         class="<%= currentPath === '/staff' ? 'active' : '' %>">
        Dashboard
      </a>

      <a href="/staff/orders"
         class="<%= currentPath.startsWith('/staff/orders') ? 'active' : '' %>">
        Orders
      </a>

    <% } %>

    <% if (currentUser && currentUser.role === 'customer') { %>

      <p class="menu-title">MAIN</p>

      <a href="/customer"
         class="<%= currentPath === '/customer' ? 'active' : '' %>">
        Dashboard
      </a>

      <a href="/customer/menu"
         class="<%= currentPath.startsWith('/customer/menu') ? 'active' : '' %>">
        Menu
      </a>

      <a href="/customer/cart"
         class="<%= currentPath.startsWith('/customer/cart') ? 'active' : '' %>">
        Cart
      </a>

      <a href="/customer/orders"
         class="<%= currentPath.startsWith('/customer/orders') ? 'active' : '' %>">
        Orders
      </a>

    <% } %>

  </nav>

  <main class="main" id="mainContent">

    <!-- SUCCESS POPUP -->
    <% if (success) { %>
      <div class="toast success" id="toast-success">
        <%= success %>
      </div>
    <% } %>

    <!-- ERROR POPUP -->
    <% if (error) { %>
      <div class="toast error" id="toast-error">
        <%= error %>
      </div>
    <% } %>

    <%- body %>

  </main>

</div>

<script src="/js/script.js"></script>

</body>
</html>