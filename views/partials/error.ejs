<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - Coffee Shop</title>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #1e1814, #2d241e);
    }

    .error-container {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }

    .error-box {
      text-align: center;
      background: rgba(255,255,255,0.95);
      padding: 40px;
      border-radius: 18px;
      max-width: 500px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      border: 1px solid rgba(255,255,255,0.5);
    }

    .error-box h1 {
      font-size: 3rem;
      margin: 0 0 15px 0;
      color: #1e1814;
    }

    .error-box p {
      font-size: 1.1rem;
      margin-bottom: 25px;
      color: #2d241e;
      opacity: 0.85;
    }

    .btn-home {
      display: inline-block;
      padding: 12px 24px;
      background: #1e1814;
      color: #fff;
      text-decoration: none;
      border-radius: 12px;
      font-weight: bold;
      transition: 0.2s;
    }

    .btn-home:hover {
      background: #d7b899;
      color: #1e1814;
      transform: translateY(-2px);
    }

    .coffee-icon {
      font-size: 3rem;
      margin-bottom: 10px;
    }
  </style>

</head>

<body>

  <div class="error-container">

    <div class="error-box">

      <div class="coffee-icon">☕</div>

      <h1>Error</h1>

      <p>
        <%= message || 'Something went wrong' %>
      </p>

      <a href="/" class="btn-home">Back to Home</a>

    </div>

  </div>

</body>
</html>