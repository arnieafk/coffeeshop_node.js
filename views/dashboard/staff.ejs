<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Dashboard - Coffee Shop</title>

  <style>
    :root {
      --espresso-deep: #1e1814;
      --espresso-mute: #2d241e;
      --cream-bg: #f4f1ee;
      --latte-accent: #d7b899;
      --text-main: #2d1e12;
      --white-glass: rgba(255, 255, 255, 0.85);
      --shadow-md: 0 10px 25px rgba(0,0,0,0.08);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: 'Segoe UI', Roboto, sans-serif;
      background: var(--cream-bg);
      color: var(--text-main);
    }

    /* TOP HEADER */
    .top-header {
      background: var(--espresso-deep);
      color: white;
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow-md);
    }

    .top-header .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logout-btn {
      background: var(--latte-accent);
      color: var(--espresso-deep);
      padding: 8px 14px;
      border-radius: 20px;
      text-decoration: none;
      font-weight: bold;
    }

    /* LAYOUT */
    .container {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR (UNIFIED DESIGN) */
    .sidebar {
      width: 270px;
      background: linear-gradient(180deg, #1e1814, #2d241e);
      color: white;
      padding: 25px 20px;
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: sticky;
      top: 0;
      box-shadow: 5px 0 25px rgba(0,0,0,0.25);
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-bottom: 15px;
      margin-bottom: 20px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar-brand .logo {
      width: 42px;
      height: 42px;
      background: var(--latte-accent);
      color: var(--espresso-deep);
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      font-weight: bold;
      font-size: 18px;
    }

    .sidebar-brand h2 {
      margin: 0;
      font-size: 16px;
      color: var(--latte-accent);
    }

    .menu-title {
      font-size: 11px;
      letter-spacing: 1px;
      opacity: 0.5;
      margin: 15px 0 8px;
    }

    .sidebar a {
      display: block;
      padding: 12px 14px;
      margin: 6px 0;
      border-radius: 12px;
      color: rgba(255,255,255,0.75);
      text-decoration: none;
      transition: 0.25s;
    }

    .sidebar a:hover {
      background: rgba(215,184,153,0.15);
      color: var(--latte-accent);
      transform: translateX(6px);
    }

    .sidebar a.active {
      background: var(--latte-accent);
      color: var(--espresso-deep);
      font-weight: bold;
    }

    .sidebar-footer {
      margin-top: auto;
      padding-top: 15px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar-footer .logout-btn {
      display: block;
      text-align: center;
      padding: 10px;
      border-radius: 12px;
      background: #c9302c;
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    /* MAIN */
    .main {
      flex: 1;
      padding: 40px;
    }

    .header {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 25px;
    }

    /* CARDS */
    .card {
      background: var(--white-glass);
      backdrop-filter: blur(10px);
      padding: 25px;
      margin-bottom: 25px;
      border-radius: 18px;
      box-shadow: var(--shadow-md);
    }

    /* METRICS */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .metric-card {
      background: var(--white-glass);
      padding: 25px;
      border-radius: 16px;
      text-align: center;
      box-shadow: var(--shadow-md);
    }

    .metric-card .icon { font-size: 2rem; }
    .metric-card .value { font-size: 1.8rem; font-weight: bold; }

    /* BUTTON */
    .btn {
      padding: 10px 18px;
      border-radius: 25px;
      background: var(--espresso-deep);
      color: white;
      border: none;
      cursor: pointer;
    }

    .btn:hover {
      background: var(--latte-accent);
      color: var(--espresso-deep);
    }

    /* STATUS */
    .status-badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
    }

    .status-pending { background: #fff3cd; color: #856404; }
    .status-preparing { background: #cce5ff; color: #004085; }
    .status-completed { background: #d4edda; color: #155724; }
  </style>
</head>

<body>

<header class="top-header">
  <div class="user-info">☕ Coffee Shop System</div>
  <div class="user-info">
    👨‍💼 Staff: <%= user.name %>
    <a class="logout-btn" href="/logout">Logout</a>
  </div>
</header>

<div class="container">

  <!-- SIDEBAR -->
  <nav class="sidebar">

    <div class="sidebar-brand">
      <div class="logo">☕</div>
      <div>
        <h2>Staff Panel</h2>
      </div>
    </div>

    <p class="menu-title">MAIN</p>
    <a href="/staff" class="active">📊 Dashboard</a>
    <a href="/staff/orders">📋 Orders</a>

    <div class="sidebar-footer">
      <a href="/logout" class="logout-btn">🚪 Logout</a>
    </div>

  </nav>

  <!-- MAIN -->
  <main class="main">

    <div class="header">Order Management</div>

    <div class="metrics-grid">
      <div class="metric-card">
        <div class="icon">⏳</div>
        <div class="value"><%= stats?.pending || 0 %></div>
        Pending
      </div>

      <div class="metric-card">
        <div class="icon">👨‍🍳</div>
        <div class="value"><%= stats?.preparing || 0 %></div>
        Preparing
      </div>

      <div class="metric-card">
        <div class="icon">✅</div>
        <div class="value"><%= stats?.completed || 0 %></div>
        Completed
      </div>
    </div>

    <div class="card">
      <h3>Active Orders</h3>

      <% orders.forEach(order => { %>
        <div class="card">
          <strong>Order #<%= order.id %></strong>
          <p><%= order.customer_name %></p>

          <span class="status-badge status-<%= order.status %>">
            <%= order.status %>
          </span>

          <p>$<%= order.total %></p>

          <% if (order.status === 'pending') { %>
            <form method="POST" action="/staff/orders/<%= order.id %>/status">
              <input type="hidden" name="status" value="preparing">
              <button class="btn">Start Preparing</button>
            </form>

          <% } else if (order.status === 'preparing') { %>
            <form method="POST" action="/staff/orders/<%= order.id %>/status">
              <input type="hidden" name="status" value="completed">
              <button class="btn">Mark Completed</button>
            </form>

          <% } else { %>
            <p>Completed ✔</p>
          <% } %>

        </div>
      <% }) %>

    </div>

  </main>

</div>

</body>
</html>