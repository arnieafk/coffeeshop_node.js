<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Staff Dashboard - Coffee Shop</title>

<link rel="stylesheet" href="/css/style.css">

</head>

<body>

<!-- Top Header -->
<header class="top-header">

  <div class="user-info">
    <span>Coffee Shop System</span>
  </div>

  <div class="user-info">

    <span>
      Staff:
      <%= user.name %>
    </span>

    <a class="logout-btn" href="/logout">
      Logout
    </a>

  </div>

</header>

<div class="container">

  <!-- Sidebar -->
  <nav class="sidebar">

    <h2>Staff Panel</h2>

    <p class="menu-title">
      Main Navigation
    </p>

    <a href="/staff" class="active">
      Dashboard
    </a>

    <a href="/staff/orders">
      Manage Orders
    </a>

  </nav>

  <!-- Main -->
  <main class="main">

    <!-- Header -->
    <div class="header">
      Order Management Dashboard
    </div>

    <!-- Stats -->
    <div class="metrics-grid">

      <div class="metric-card">

        <div class="value">
          <%= stats?.pending || 0 %>
        </div>

        <div class="label">
          Pending Orders
        </div>

      </div>

      <div class="metric-card">

        <div class="value">
          <%= stats?.preparing || 0 %>
        </div>

        <div class="label">
          Preparing Orders
        </div>

      </div>

      <div class="metric-card">

        <div class="value">
          <%= stats?.completed || 0 %>
        </div>

        <div class="label">
          Completed Orders
        </div>

      </div>

    </div>

    <!-- Orders -->
    <div class="card">

      <h3 style="
        margin-top: 0;
        margin-bottom: 20px;
        color: var(--espresso-deep);
      ">

        Active Orders

      </h3>

      <% if (orders && orders.length > 0) { %>

        <% orders.forEach(order => { %>

          <div class="card" style="margin-bottom: 20px;">

            <!-- Order Header -->
            <div style="
              display: flex;
              justify-content: space-between;
              align-items: center;
              flex-wrap: wrap;
              gap: 15px;
              margin-bottom: 15px;
            ">

              <div>

                <h3 style="
                  margin: 0;
                  color: var(--espresso-deep);
                ">

                  Order #<%= order.id %>

                </h3>

                <p style="
                  margin: 6px 0 0;
                  opacity: 0.7;
                ">

                  Customer:
                  <%= order.customer_name %>

                </p>

              </div>

              <div style="text-align: right;">

                <div style="
                  font-size: 1.2rem;
                  font-weight: 700;
                  color: var(--espresso-deep);
                  margin-bottom: 8px;
                ">

                  ₱<%= Number(order.total || 0).toFixed(2) %>

                </div>

                <span class="status-badge status-<%= order.status %>">

                  <%= order.status %>

                </span>

              </div>

            </div>

            <!-- Actions -->
            <div class="card-actions">

              <% if (order.status === 'pending') { %>

                <form method="POST">

                  <input
                    type="hidden"
                    name="status"
                    value="preparing"
                  >

                  <button class="btn btn-info">
                    Start Preparing
                  </button>

                </form>

              <% } else if (order.status === 'preparing') { %>

                <form method="POST">

                  <input
                    type="hidden"
                    name="status"
                    value="completed"
                  >

                  <button class="btn btn-success">
                    Mark Completed
                  </button>

                </form>

              <% } else { %>

                <button
                  class="btn btn-secondary"
                  disabled
                >

                  Completed

                </button>

              <% } %>

            </div>

          </div>

        <% }) %>

      <% } else { %>

        <div style="
          text-align: center;
          padding: 30px 20px;
        ">

          <h3>No Active Orders</h3>

          <p style="opacity: 0.7;">

            There are currently no customer orders.

          </p>

        </div>

      <% } %>

    </div>

  </main>

</div>

</body>
</html>