<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Staff Dashboard - Coffee Shop</title>
<link rel="stylesheet" href="/css/style.css">

<style>
:root {
  --espresso-deep: #1e1814;
  --espresso-mute: #2d241e;
  --cream-bg: #f4f1ee;
  --latte-accent: #d7b899;
  --text-main: #2d1e12;
  --white-glass: rgba(255, 255, 255, 0.85);
  --shadow-md: 0 10px 25px rgba(0,0,0,0.08);
}

/* (UNCHANGED STYLE CONTINUES EXACTLY SAME AS YOUR CODE) */
</style>

</head>

<body>

<header class="top-header">

  <div class="user-info"> Coffee Shop System</div>

  <!--  ADD HAMBURGER BUTTON -->
  <button class="menu-toggle" onclick="toggleSidebar()"></button>

  <div class="user-info">
    Staff: <%= user.name %>
    <a class="logout-btn" href="/logout">Logout</a>
  </div>

</header>

<div class="container">

  <!--  ADD ONLY ID -->
  <nav class="sidebar" id="sidebar">

    <div class="sidebar-brand">
      <div class="logo"></div>
      <div>
        <h2>Staff Panel</h2>
      </div>
    </div>

    <p class="menu-title">MAIN</p>
    <a href="/staff" class="active"> Dashboard</a>
    <a href="/staff/orders"> Orders</a>

    <div class="sidebar-footer">
      <a href="/logout" class="logout-btn"> Logout</a>
    </div>

  </nav>

  <main class="main">

    <div class="header">Order Management</div>

    <div class="metrics-grid">
      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.pending || 0 %></div>
        <div class="label">Pending</div>
      </div>

      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.preparing || 0 %></div>
        <div class="label">Preparing</div>
      </div>

      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.completed || 0 %></div>
        Completed
      </div>
    </div>

    <div class="card">
      <h3>Active Orders</h3>

      <% orders.forEach(order => { %>
        <div class="card">
          <strong>Order #<%= order.id %></strong>
          <p><%= order.customer_name %></p>

          <span class="status-badge status-<%= order.status %>">
            <%= order.status %>
          </span>

          <p>$<%= order.total %></p>

          <% if (order.status === 'pending') { %>
            <form method="POST">
              <input type="hidden" name="status" value="preparing">
              <button class="btn">Start Preparing</button>
            </form>

          <% } else if (order.status === 'preparing') { %>
            <form method="POST">
              <input type="hidden" name="status" value="completed">
              <button class="btn">Mark Completed</button>
            </form>

          <% } else { %>
            <p>Completed </p>
          <% } %>

        </div>
      <% }) %>

    </div>

  </main>

</div>

<!--  ADD TOGGLE SCRIPT ONLY -->
<script src="/js/script.js"></script>

</body>
</html>   