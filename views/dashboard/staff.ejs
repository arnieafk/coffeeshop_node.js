<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Dashboard - Coffee Shop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="top-header">
  <div class="left-header">Coffee Shop System</div>
  <button class="menu-toggle" onclick="toggleSidebar()"></button>
  <div class="user-info">
    <span>Staff: <%= user.name %></span>
    <a href="/logout" class="logout-btn">Logout</a>
  </div>
</header>
<div class="container">
  <nav class="sidebar" id="sidebar">
    <h2>STAFF PANEL</h2>
    <p class="menu-title">MAIN</p>
    <a href="/staff" class="active">Dashboard</a>
    <a href="/staff/orders">Orders</a>
    <div class="sidebar-footer">
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </nav>
  <main class="main">
    <div class="header">Order Management</div>
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.pending || 0 %></div>
        <div class="label">Pending</div>
      </div>
      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.preparing || 0 %></div>
        <div class="label">Preparing</div>
      </div>
      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.completed || 0 %></div>
        <div class="label">Completed</div>
      </div>
    </div>
    <% if (orders && orders.length > 0) { %>
    <div class="order-card-list">
      <% orders.forEach(order => { %>
      <div class="order-card">
        <div class="order-card-header order-summary">
          <div>
            <h3>Order #<%= order.id %></h3>
            <p class="text-muted"><%= order.customer_name %></p>
          </div>
          <div class="order-total">
            <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
          </div>
        </div>
        <div class="order-card-items">
          <% if (order.items && order.items.length > 0) { %>
            <% order.items.forEach(item => { %>
            <div class="order-card-item order-item-row">
              <div class="order-item-info">
                <div class="order-item-name"><%= item.name %></div>
                <div class="order-meta">Qty: <%= item.quantity %></div>
              </div>
              <div class="order-item-price">$<%= (item.price * item.quantity).toFixed(2) %></div>
            </div>
            <% }) %>
          <% } %>
        </div>
        <div class="card-actions">
          <form method="POST" action="/staff/orders/<%= order.id %>/status">
            <% if (order.status === 'Pending' || order.status === 'pending') { %>
            <input type="hidden" name="status" value="Preparing" />
            <button class="btn btn-primary btn-small" type="submit">Start Preparing</button>
            <% } else if (order.status === 'Preparing' || order.status === 'preparing') { %>
            <input type="hidden" name="status" value="Completed" />
            <button class="btn btn-success btn-small" type="submit">Mark Completed</button>
            <% } else { %>
            <span class="status-badge status-completed">Completed</span>
            <% } %>
          </form>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="card empty-state">
      <h3>No active orders</h3>
      <p>There are no orders to work on right now.</p>
    </div>
    <% } %>
  </main>
</div>
<script src="/js/script.js"></script>
</body>
</html>   