<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Customer Dashboard - Coffee Shop</title>

<style>
:root {
  --espresso-deep: #1e1814;
  --espresso-mute: #2d241e;
  --cream-bg: #f4f1ee;
  --latte-accent: #d7b899;
  --text-main: #2d1e12;
  --white-glass: rgba(255, 255, 255, 0.85);
  --shadow-md: 0 10px 25px rgba(0,0,0,0.08);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Segoe UI', Roboto, sans-serif;
  background: var(--cream-bg);
  color: var(--text-main);
}

.container {
  display: flex;
  min-height: 100vh;
}

/* HEADER */
.top-header {
  background: var(--espresso-deep);
  color: white;
  padding: 15px 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-md);
}

.top-header .user-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logout-btn {
  background: var(--latte-accent);
  color: var(--espresso-deep);
  padding: 8px 14px;
  border-radius: 20px;
  text-decoration: none;
  font-weight: bold;
}

/* SIDEBAR */
.sidebar {
  width: 270px;
  background: linear-gradient(180deg, #1e1814, #2d241e);
  color: white;
  padding: 25px 20px;
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: sticky;
  top: 0;
  box-shadow: 5px 0 25px rgba(0,0,0,0.25);
}

/* MAIN */
.main {
  flex: 1;
  padding: 40px;
}

/* YOUR ORIGINAL UI UNCHANGED BELOW */
.header {
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 25px;
}

.card {
  background: var(--white-glass);
  backdrop-filter: blur(10px);
  padding: 25px;
  margin-bottom: 25px;
  border-radius: 18px;
  box-shadow: var(--shadow-md);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-bottom: 30px;
}

.metric-card {
  background: var(--white-glass);
  padding: 25px;
  border-radius: 16px;
  text-align: center;
  box-shadow: var(--shadow-md);
}
</style>

</head>

<body>

<header class="top-header">

  <div class="user-info">
    <span>☕ Coffee Shop</span>
  </div>

  <!-- ✅ ADD HAMBURGER BUTTON -->
  <button class="menu-toggle" onclick="toggleSidebar()">☰</button>

  <div class="user-info">
    <span>👤 <%= user.name %></span>
    <a href="/logout" class="logout-btn">Logout</a>
  </div>

</header>

<div class="container">

  <!-- ✅ ADD ID ONLY -->
  <nav class="sidebar" id="sidebar">
    <h2>☕ Customer</h2>

    <a href="/customer" class="active">🏠 Dashboard</a>
    <a href="/customer/menu">📖 Menu</a>
    <a href="/customer/cart">🛒 Cart</a>
    <a href="/customer/orders">📋 Orders</a>
  </nav>

  <main class="main">

    <div class="header">Welcome ☕</div>

    <div class="card">
      <h3>Start Ordering Your Coffee</h3>
      <a href="/customer/menu" class="btn">Browse Menu</a>
    </div>

    <div class="metrics-grid">

      <div class="metric-card">
        <div class="icon">📦</div>
        <div class="value"><%= stats?.totalOrders || 0 %></div>
        <div class="label">Orders</div>
      </div>

      <div class="metric-card">
        <div class="icon">⭐</div>
        <div class="value"><%= stats?.rating || 5 %></div>
        <div class="label">Rating</div>
      </div>

      <div class="metric-card">
        <div class="icon">💝</div>
        <div class="value"><%= stats?.favoriteItem || 'Coffee' %></div>
        <div class="label">Favorite</div>
      </div>

    </div>

  </main>

</div>

<!-- ✅ ADD TOGGLE SCRIPT ONLY -->
<script src="/js/script.js"></script>

</body>
</html>