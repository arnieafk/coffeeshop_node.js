<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Customer Dashboard - Coffee Shop</title>

<link rel="stylesheet" href="/css/style.css">

</head>

<body>

<!-- Top Header -->
<header class="top-header">

  <div class="user-info">
    <span>Coffee Shop</span>
  </div>

  <div class="user-info">

    <span>
      Welcome,
      <%= user?.name || 'Customer' %>
    </span>

    <a href="/logout" class="logout-btn">
      Logout
    </a>

  </div>

</header>

<div class="container">

  <!-- Sidebar -->
  <nav class="sidebar">

    <h2>Customer Panel</h2>

    <p class="menu-title">Main Navigation</p>

    <a href="/customer" class="active">
      Dashboard
    </a>

    <a href="/customer/menu">
      Browse Menu
    </a>

    <a href="/customer/cart">
      Cart
    </a>

    <a href="/customer/orders">
      My Orders
    </a>

  </nav>

  <!-- Main Content -->
  <main class="main">

    <!-- Dashboard Header -->
    <div class="header">
      Customer Dashboard
    </div>

    <!-- Welcome Card -->
    <div class="card">

      <h3 style="
        margin-top: 0;
        color: var(--espresso-deep);
      ">

        Welcome Back,
        <%= user?.name || 'Customer' %>

      </h3>

      <p style="
        margin-bottom: 25px;
        line-height: 1.8;
      ">

        Explore our coffee selections,
        place new orders,
        and manage your purchases easily.

      </p>

      <div class="card-actions">

        <a href="/customer/menu" class="btn btn-primary">
          Browse Menu
        </a>

        <a href="/customer/orders" class="btn btn-secondary">
          View Orders
        </a>

      </div>

    </div>

    <!-- Metrics -->
    <div class="metrics-grid">

      <!-- Total Orders -->
      <div class="metric-card">

        <div class="value">
          <%= stats?.totalOrders || 0 %>
        </div>

        <div class="label">
          Total Orders
        </div>

      </div>

      <!-- Rating -->
      <div class="metric-card">

        <div class="value">
          <%= stats?.rating || 5 %>
        </div>

        <div class="label">
          Customer Rating
        </div>

      </div>

      <!-- Favorite -->
      <div class="metric-card">

        <div class="value">
          <%= stats?.favoriteItem || 'Coffee' %>
        </div>

        <div class="label">
          Favorite Item
        </div>

      </div>

    </div>

    <!-- Quick Actions -->
    <div class="card">

      <h3 style="
        margin-top: 0;
        margin-bottom: 20px;
        color: var(--espresso-deep);
      ">

        Quick Actions

      </h3>

      <div class="card-actions">

        <a href="/customer/menu" class="btn btn-primary">
          Order Coffee
        </a>

        <a href="/customer/cart" class="btn btn-info">
          View Cart
        </a>

        <a href="/customer/orders" class="btn btn-success">
          Track Orders
        </a>

      </div>

    </div>

    <!-- Customer Notes -->
    <div class="card">

      <h3 style="
        margin-top: 0;
        color: var(--espresso-deep);
      ">

        Coffee Shop Updates

      </h3>

      <p style="
        margin-bottom: 0;
        line-height: 1.8;
      ">

        Thank you for choosing our coffee shop.
        We continuously improve our products and services
        to give you the best ordering experience.

      </p>

    </div>

  </main>

</div>

</body>
</html>