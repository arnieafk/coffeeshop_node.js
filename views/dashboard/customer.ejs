<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Dashboard - Coffee Shop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="top-header">
  <div class="left-header">Coffee Shop System</div>
  <button class="menu-toggle" onclick="toggleSidebar()"></button>
  <div class="user-info">
    <span>Hello, <%= user.name %></span>
    <a href="/logout" class="logout-btn">Logout</a>
  </div>
</header>
<div class="container">
  <nav class="sidebar" id="sidebar">
    <h2>CUSTOMER</h2>
    <p class="menu-title">MAIN</p>
    <a href="/customer" class="active">Dashboard</a>
    <a href="/customer/menu">Menu</a>
    <a href="/customer/cart">Cart</a>
    <a href="/customer/orders">Orders</a>
    <div class="sidebar-footer">
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </nav>
  <main class="main">
    <div class="header">Welcome</div>
    <div class="card">
      <h3>Start your coffee order</h3>
      <p class="text-muted">Browse the menu, add items to your cart, and track your orders from one dashboard.</p>
      <a href="/customer/menu" class="btn btn-primary">Browse Menu</a>
    </div>
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.totalOrders || 0 %></div>
        <div class="label">Orders</div>
      </div>
      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.rating || 5 %></div>
        <div class="label">Rating</div>
      </div>
      <div class="metric-card">
        <div class="icon"></div>
        <div class="value"><%= stats?.favoriteItem || 'Coffee' %></div>
        <div class="label">Favorite</div>
      </div>
    </div>
  </main>
</div>
<script src="/js/script.js"></script>
</body>
</html>