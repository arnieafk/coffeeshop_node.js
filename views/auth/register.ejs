<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register - Coffee Shop</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="auth">
    <div class="auth-left">
      <div class="auth-hero">
        <h1>Join Coffee Shop</h1>
        <p>Create your user account and begin ordering or managing products with a clean, modern design.</p>
      </div>
    </div>
    <div class="auth-right">
      <div class="auth-box">
        <h2 class="auth-title">Register</h2>
        <% if (error) { %>
          <div class="alert"><%= error %></div>
        <% } %>
        <form method="POST" action="/register">
          <div class="form-group">
            <label for="name">Name</label>
            <input id="name" type="text" name="name" required class="form-control" />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input id="email" type="email" name="email" required class="form-control" />
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input id="password" type="password" name="password" required class="form-control" />
          </div>
          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <input id="confirmPassword" type="password" name="confirmPassword" required class="form-control" />
          </div>
          <button type="submit" class="btn btn-primary btn-full">Create Account</button>
        </form>
        <p class="auth-note">Already registered? <a href="/login">Login</a></p>
      </div>
    </div>
  </div>
</body>
</html>