<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login - Coffee Shop</title>
<link rel="stylesheet" href="/css/style.css">

<style>
:root {
  --espresso-deep:#1e1814;
  --espresso-mute:#2d241e;
  --cream-bg:#f4f1ee;
  --latte-accent:#d7b899;
  --text-main:#2d1e12;
  --white-glass:rgba(255,255,255,0.95);
  --shadow-md:0 10px 25px rgba(0,0,0,0.08);
  --error:#e74c3c;
  --error-bg:#fadbd8;
}

* { box-sizing:border-box; }

body {
  margin:0;
  font-family:'Segoe UI',sans-serif;
  background: linear-gradient(135deg, #1e1814, #2d241e);
}

/* AUTH LAYOUT */
.auth {
  display:flex;
  min-height:100vh;
}

/* LEFT SIDE */
.left {
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  color:white;
  padding:40px;
  background: radial-gradient(circle at top, rgba(215,184,153,0.15), transparent 60%);
}

.left h1 {
  color:var(--latte-accent);
  font-size:2.6rem;
  margin-bottom:10px;
}

.left p {
  opacity:0.85;
  font-size:1.05rem;
}

/* RIGHT SIDE */
.right {
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px;
  background:var(--cream-bg);
}

/* LOGIN BOX */
.box {
  width:100%;
  max-width:420px;
  background:var(--white-glass);
  padding:40px;
  border-radius:18px;
  box-shadow:var(--shadow-md);
  border:1px solid rgba(255,255,255,0.5);
}

.box h2 {
  margin-bottom:20px;
  color:var(--espresso-deep);
}

/* INPUTS */
label {
  font-weight:600;
  font-size:0.9rem;
  color:var(--text-main);
}

input {
  width:100%;
  padding:12px;
  margin-top:6px;
  margin-bottom:16px;
  border-radius:10px;
  border:1px solid #ddd;
  transition:0.2s;
}

input:focus {
  outline:none;
  border-color:var(--latte-accent);
  box-shadow:0 0 0 3px rgba(215,184,153,0.25);
}

/* BUTTON */
button {
  width:100%;
  padding:14px;
  border:none;
  border-radius:12px;
  background:var(--espresso-deep);
  color:white;
  font-weight:bold;
  cursor:pointer;
  transition:0.2s;
}

button:hover {
  background:var(--latte-accent);
  color:var(--espresso-deep);
  transform:translateY(-2px);
}

/* LINKS */
a {
  color:var(--espresso-deep);
  text-decoration:none;
  font-weight:bold;
}

a:hover {
  color:var(--latte-accent);
}

/* ERROR */
.error {
  background:var(--error-bg);
  color:var(--error);
  padding:10px;
  border-radius:8px;
  margin-bottom:15px;
  font-size:0.9rem;
}

/* RESPONSIVE */
@media (max-width:768px) {
  .auth {
    flex-direction:column;
  }

  .left {
    padding:30px;
    text-align:center;
  }
}
</style>

</head>

<body>

<div class="auth">

  <!-- LEFT -->
  <div class="left">
    <div>
      <h1>☕ Coffee Shop System</h1>
      <p>Fresh coffee, smooth management, fast ordering experience.</p>
    </div>
  </div>

  <!-- RIGHT -->
  <div class="right">
    <div class="box">

      <h2>Login</h2>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">

        <label>Email</label>
        <input type="email" name="email" required>

        <label>Password</label>
        <input type="password" name="password" required>

        <button type="submit">Login</button>

      </form>

      <p style="margin-top:15px; text-align:center;">
        No account? <a href="/register">Register</a>
      </p>

    </div>
  </div>

</div>

</body>
</html>