<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders Management - Staff</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="top-header">
    <div class="user-info">
        <span>👨‍💼 Staff Dashboard</span>
    </div>

    <div class="user-info">
        <span>
            Welcome,
            <%= typeof user !== 'undefined' ? user.name : 'Staff' %>
        </span>
        <a href="/logout" class="logout-btn">Logout</a>
    </div>
</header>


<div class="container">

<nav class="sidebar">
    <h2>☕ Staff Panel</h2>
    <a href="/staff">📊 Dashboard</a>
    <a href="/staff/orders">📋 Orders</a>
</nav>



<main class="main">

<div class="header">
Order Management
</div>



<!-- Metrics -->
<div class="metrics-grid">

    <div class="metric-card">
        <div class="icon">⏳</div>
        <div class="value">
            <%= typeof orders !== 'undefined'
                ? orders.filter(o => o.status === 'Pending').length
                : 0 %>
        </div>
        <div class="label">Pending Orders</div>
    </div>

    <div class="metric-card">
        <div class="icon">👨‍🍳</div>
        <div class="value">
            <%= typeof orders !== 'undefined'
                ? orders.filter(o => o.status === 'Preparing').length
                : 0 %>
        </div>
        <div class="label">Preparing</div>
    </div>

    <div class="metric-card">
        <div class="icon">✅</div>
        <div class="value">
            <%= typeof orders !== 'undefined'
                ? orders.filter(o => o.status === 'Completed').length
                : 0 %>
        </div>
        <div class="label">Completed</div>
    </div>

</div>



<!-- Orders -->
<% if (orders && orders.length > 0) { %>

<% orders.forEach(order => { %>

<div class="card" style="margin-bottom:15px;">

    <!-- Header -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;">

        <div>
            <h4 style="margin:0;">
                Order #<%= order.id %>
            </h4>

            <p style="margin:5px 0;opacity:0.7;">
                <%= order.customer_name %>
                •
                <%= new Date(order.created_at).toLocaleString() %>
            </p>
        </div>


        <div style="text-align:right;">
            <div style="font-weight:700;color:var(--espresso-deep);">
                $<%= Number(order.total).toFixed(2) %>
            </div>

            <span class="status-badge status-<%= order.status.toLowerCase() %>">
                <%= order.status %>
            </span>
        </div>

    </div>



    <!-- Items -->
    <% if (order.items && order.items.length > 0) { %>

    <div style="margin-bottom:15px;">

        <% order.items.forEach(item => { %>

        <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #eee;">

            <span>
                <%= item.name %> × <%= item.quantity %>
            </span>

            <span>
                $<%= (item.price * item.quantity).toFixed(2) %>
            </span>

        </div>

        <% }) %>

    </div>

    <% } %>



    <!-- Update Status -->
    <div style="display:flex;justify-content:flex-end;gap:10px;">

        <form method="POST"
              action="/staff/orders/<%= order.id %>/status"
              style="display:flex;gap:10px;">

            <select name="status"
                    style="padding:8px;border-radius:8px;">

                <option value="Pending"
                    <%= order.status === 'Pending' ? 'selected' : '' %>>
                    Pending
                </option>

                <option value="Preparing"
                    <%= order.status === 'Preparing' ? 'selected' : '' %>>
                    Preparing
                </option>

                <option value="Completed"
                    <%= order.status === 'Completed' ? 'selected' : '' %>>
                    Completed
                </option>

            </select>

            <button class="btn btn-primary">
                Update
            </button>

        </form>

    </div>

</div>

<% }) %>

<% } else { %>

<div class="card" style="text-align:center;">
    <div style="font-size:3rem;">📋</div>
    <h3>No Orders</h3>
</div>

<% } %>



</main>
</div>

</body>
</html>