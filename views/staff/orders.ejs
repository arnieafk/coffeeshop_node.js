<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders Management - Staff</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="top-header">
  <div class="left-header">Coffee Shop System</div>
  <button class="menu-toggle" onclick="toggleSidebar()"></button>
  <div class="user-info">
    <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Staff' %></span>
    <a href="/logout" class="logout-btn">Logout</a>
  </div>
</header>


<div class="container">
  <nav class="sidebar" id="sidebar">
    <h2>STAFF PANEL</h2>
    <p class="menu-title">MAIN</p>
    <a href="/staff">Dashboard</a>
    <a href="/staff/orders">Orders</a>
    <div class="sidebar-footer">
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </nav>
  <main class="main">
      <div class="header">Order Management</div>
      <div class="metrics-grid">
        <div class="metric-card"><div class="icon"></div><div class="value"><%= typeof orders !== 'undefined' ? orders.filter(o => o.status === 'Pending').length : 0 %></div><div class="label">Pending Orders</div></div>
        <div class="metric-card"><div class="icon"></div><div class="value"><%= typeof orders !== 'undefined' ? orders.filter(o => o.status === 'Preparing').length : 0 %></div><div class="label">Preparing</div></div>
        <div class="metric-card"><div class="icon"></div><div class="value"><%= typeof orders !== 'undefined' ? orders.filter(o => o.status === 'Completed').length : 0 %></div><div class="label">Completed</div></div>
      </div>



<!-- Orders -->
      <% if (orders && orders.length > 0) { %>

      <% orders.forEach(order => { %>

      <div class="order-card">

    <div class="order-card-header order-summary">
        <div class="order-details">
            <h4>Order #<%= order.id %></h4>
            <p class="order-meta"><%= order.customer_name %> - <%= formatManilaDateTime(order.created_at) %></p>
        </div>
        <div class="order-details order-total">
            <div class="order-highlight">$<%= Number(order.total).toFixed(2) %></div>
            <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
        </div>
    </div>



    <% if (order.items && order.items.length > 0) { %>
    <div class="order-card-items">
        <% order.items.forEach(item => { %>
        <div class="order-card-item order-item-row">
            <div class="order-item-info">
                <div class="order-item-name"><%= item.name %></div>
                <div class="order-meta">Qty: <%= item.quantity %></div>
            </div>
            <div class="order-item-price">$<%= (item.price * item.quantity).toFixed(2) %></div>
        </div>
        <% }) %>
    </div>
    <% } %>



    <div class="card-actions">
        <form method="POST" action="/staff/orders/<%= order.id %>/status" class="status-form">
            <select name="status" class="status-select">
                <option value="Pending" <%= order.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                <option value="Preparing" <%= order.status === 'Preparing' ? 'selected' : '' %>>Preparing</option>
                <option value="Completed" <%= order.status === 'Completed' ? 'selected' : '' %>>Completed</option>
            </select>
            <button class="btn btn-primary">Update</button>
        </form>
    </div>

</div>

<% }) %>

<% } else { %>

<div class="card empty-state">
    <h3>No Orders</h3>
    <p>There are no orders to process at this time.</p>
</div>

<% } %>



</main>
</div>

</body>
</html>