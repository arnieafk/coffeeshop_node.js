<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= staff ? 'Edit Staff' : 'Add Staff' %></title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header class="top-header">

  <div class="user-info">
    <span>Coffee Shop System</span>
  </div>

  <div class="user-info">
    <span>
      Admin:
      <strong><%= user.name %></strong>
    </span>

    <a class="logout-btn" href="/logout">Logout</a>
  </div>

</header>

<div class="container">

<nav class="sidebar">
  <h2>ADMIN PANEL</h2>
  <p class="menu-title">Main</p>

  <a href="/admin">Dashboard</a>
  <a href="/admin/products">Products</a>
  <a href="/admin/orders">Orders</a>
  <a href="/admin/payments">Payments</a>
  <a href="/admin/staff">Staff</a>
</nav>

<main class="main">

  <div class="header">
    <%= staff ? 'Edit Staff' : 'Add New Staff' %>
  </div>

  <div class="card">

                  <form method="POST" action="<%= action %>" style="display:flex; flex-direction:column; gap:15px;">

                <!-- NAME -->
                <div>
                  <label>Full Name</label>
                  <input type="text" name="name" required
                    value="<%= staff ? staff.name : '' %>">
                </div>

                <!-- ROLE -->
                <div>
                  <label>Role</label>
                  <select name="role">
                    <option value="staff" <%= staff && staff.role === 'staff' ? 'selected' : '' %>>Staff</option>
                    <option value="admin" <%= staff && staff.role === 'admin' ? 'selected' : '' %>>Admin</option>
                  </select>
                </div>

                <!-- STATUS -->
                <div>
                  <label>Status</label>
                  <select name="status">
                    <option value="active" <%= staff && staff.status === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="inactive" <%= staff && staff.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                  </select>
                </div>

                <!-- EMAIL -->
                <div>
                  <label>Email</label>
                  <input type="email" name="email" required
                    value="<%= staff ? staff.email : '' %>">
                </div>

                <!-- PASSWORD ONLY CREATE -->
                <% if (!staff) { %>
                <div>
                  <label>Password</label>
                  <input type="password" name="password" required>
                </div>
                <% } %>

                <button type="submit">
                  <%= staff ? 'Update Staff' : 'Create Staff' %>
                </button>

              </form>

  </div>

</main>

</div>

</body>
</html>