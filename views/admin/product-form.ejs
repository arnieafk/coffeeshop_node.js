<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header class="top-header">
    <div class="user-info">
        <span> Admin Dashboard</span>
    </div>

    <div class="user-info">
        <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Admin' %></span>
        <a href="/logout" class="logout-btn">Logout</a>
    </div>
</header>

<div class="container">

<nav class="sidebar">
    <h2> Admin Panel</h2>

    <a href="/admin"> Dashboard</a>
    <a href="/admin/products"> Products</a>
    <a href="/admin/orders"> Orders</a>
    <a href="/admin/payments"> Payments</a>
</nav>

<main class="main">

    <div class="header">
        <%= title %>
    </div>

    <div class="card">
        <div style="display:flex; gap:15px; flex-wrap:wrap;">
            <a href="/admin/products" class="btn btn-secondary">Back to Products</a>
            <a href="/admin/orders" class="btn btn-secondary">Orders</a>
            <a href="/admin/payments" class="btn btn-secondary">Payments</a>
        </div>
    </div>

    <div class="card">

        <h2 style="margin-bottom:25px;">
            <%= product ? 'Edit Product' : 'Add New Product' %>
        </h2>

        <form method="POST" action="<%= action %>">

            <!-- NAME -->
            <div style="margin-bottom:20px;">
                <label style="font-weight:600;">Product Name</label>

                <input type="text"
                    name="name"
                    value="<%= product ? product.name : '' %>"
                    required
                    style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px;">
            </div>

            <!-- PRICE -->
            <div style="margin-bottom:20px;">
                <label style="font-weight:600;">Price</label>

                <input type="number"
                    step="0.01"
                    name="price"
                    value="<%= product ? Number(product.price || 0).toFixed(2) : '' %>"
                    required
                    style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px;">
            </div>

            <!-- STOCK (INVENTORY CORE) -->
            <div style="margin-bottom:20px;">
                <label style="font-weight:600;">
                    Stock Quantity
                </label>

                <input type="number"
                    name="stock"
                    min="0"
                    value="<%= product ? (product.stock ?? 0) : 0 %>"
                    required
                    style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px;">

                <small style="display:block; margin-top:6px; opacity:0.6;">
                    ⚠️ Update this when items are restocked or sold
                </small>
            </div>

            <!-- DESCRIPTION -->
            <div style="margin-bottom:30px;">
                <label style="font-weight:600;">Description</label>

                <textarea name="description"
                    rows="5"
                    required
                    style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px;"><%= product ? product.description : '' %></textarea>
            </div>

            <!-- BUTTONS -->
            <div style="display:flex; gap:15px; flex-wrap:wrap;">
                <button type="submit" class="btn btn-primary">
                    Save Product
                </button>

                <a href="/admin/products" class="btn btn-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </div>

    <!-- INVENTORY TIP -->
    <div class="card">
        <h3>Inventory Reminder</h3>
        <ul style="line-height:1.8; padding-left:20px;">
            <li>Stock = number of items available</li>
            <li>System will show LOW STOCK if ≤ 5</li>
            <li>Set stock = 0 if unavailable</li>
        </ul>
    </div>

</main>

</div>

</body>
</html>