<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<!-- Top Header -->
<header class="top-header">
  <div class="left-header">Coffee Shop System</div>
  <button class="menu-toggle" onclick="toggleSidebar()"></button>
  <div class="user-info">
    <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Admin' %></span>
    <a href="/logout" class="logout-btn">Logout</a>
  </div>
</header>


<div class="container">

    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <h2>Admin Panel</h2>
        <a href="/admin">Dashboard</a>
        <a href="/admin/products">Products</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/payments">Payments</a>
    </nav>



    <!-- Main Content -->
    <main class="main">

        <div class="header">
            <%= title %>
        </div>


        <!-- Quick Navigation -->
        <div class="card btn-link-group">
            <a href="/admin/products" class="btn btn-secondary">Back to Products</a>
            <a href="/admin/orders" class="btn btn-secondary">Orders</a>
            <a href="/admin/payments" class="btn btn-secondary">Payments</a>
        </div>



        <!-- Product Form Card -->
        <div class="card">

            <h2 class="order-section-title"><%= product ? 'Edit Product' : 'Add New Product' %></h2>

            <form method="POST" action="<%= action %>">

                <!-- Product Name -->
                <div class="form-field">
                    <label class="form-label">Product Name</label>
                    <input
                        type="text"
                        name="name"
                        value="<%= product ? product.name : '' %>"
                        required
                        placeholder="Enter product name"
                        class="form-input">
                </div>

                <!-- Price -->
                <div class="form-field">
                    <label class="form-label">Price</label>
                    <input
                        type="number"
                        step="0.01"
                        name="price"
                        value="<%= product ? product.price : '' %>"
                        required
                        placeholder="Enter price"
                        class="form-input">
                </div>

                <!-- Stock -->
                <div class="form-field">
                    <label class="form-label">Stock</label>
                    <input
                        type="number"
                        name="stock"
                        min="0"
                        value="<%= product ? product.stock : 0 %>"
                        required
                        placeholder="Enter stock quantity"
                        class="form-input">
                </div>

                <!-- Description -->
                <div class="form-field">
                    <label class="form-label">Description</label>
                    <textarea
                        name="description"
                        rows="5"
                        required
                        placeholder="Enter product description"
                        class="form-textarea"><%= product ? product.description : '' %></textarea>
                </div>

                <!-- Buttons -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save Product</button>
                    <a href="/admin/products" class="btn btn-secondary">Cancel</a>
                </div>

            </form>

        </div>


        <!-- Tips Card -->
        <div class="card">
            <h3>Product Tips</h3>
            <ul class="list-notes">
                <li>Use clear and unique product names</li>
                <li>Set accurate pricing for menu consistency</li>
                <li>Add short but appealing descriptions</li>
                <li>Update products regularly for inventory tracking</li>
            </ul>
        </div>

    </main>

</div>

</body>
</html>