<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orders Management - Admin</title>
<link rel="stylesheet" href="/css/style.css">

<style>
.table-container{
  background:white;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 10px 25px rgba(0,0,0,0.08);
}

.table{
  width:100%;
  border-collapse:collapse;
}

.table thead{
  background:linear-gradient(135deg, var(--espresso-deep), var(--espresso-mute));
  color:white;
}

.table th{
  padding:14px;
  text-transform:uppercase;
  font-size:0.85rem;
  letter-spacing:0.5px;
}

.table td{
  padding:14px;
  border-bottom:1px solid #eee;
  font-size:0.95rem;
  vertical-align: top;
}

/* =========================
   🔥 FIXED ACTION COLUMN
========================= */

.actions{
  display: flex !important;
  flex-direction: column !important;
  gap: 8px !important;
  align-items: stretch !important;
  width: 100%;
}

/* each button/form full width */
.actions a,
.actions button,
.actions form{
  width: 100%;
}

/* form layout inside actions */
.actions form{
  display: flex !important;
  flex-direction: row !important;
  gap: 6px;
  align-items: center;
}

/* dropdown fix */
.actions select{
  flex: 1;
  height: 34px;
}

/* buttons uniform */
.actions button,
.actions a{
  height: 34px;
  display: flex;
  justify-content: center;
  align-items: center;
  white-space: nowrap;
}

/* status badge */
.status-badge{
  padding:6px 12px;
  border-radius:20px;
  font-size:0.75rem;
  font-weight:700;
  display:inline-block;
}

.status-pending{ background:rgba(241,196,15,0.15); color:#7a5a0f; }
.status-preparing{ background:rgba(52,152,219,0.15); color:#1b4f72; }
.status-completed{ background:rgba(39,174,96,0.15); color:#196f3d; }
</style>

</head>

<body>

<header class="top-header">
  <div class="user-info">
    <span>Admin Dashboard</span>
  </div>

  <div class="user-info">
    <span>
      Welcome,
      <%= typeof user !== 'undefined' ? user.name : 'Admin' %>
    </span>

    <a href="/logout" class="logout-btn">Logout</a>
  </div>
</header>

<div class="container">

<nav class="sidebar">
  <h2>Admin Panel</h2>
  <a href="/admin">Dashboard</a>
  <a href="/admin/products">Products</a>
  <a href="/admin/orders" class="active">Orders</a>
  <a href="/admin/payments">Payments</a>
  <a href="/admin/staff">Staff Management</a>
</nav>

<main class="main">

<div class="header">Orders Management</div>

<% if (orders && orders.length > 0) { %>

<div class="table-container">

<table class="table">

<thead>
<tr>
  <th>Order</th>
  <th>Customer</th>
  <th>Email</th>
  <th>Assigned Staff</th>
  <th>Status</th>
  <th>Total</th>
  <th>Date</th>
  <th>Actions</th>
</tr>
</thead>

<tbody>

<% orders.forEach(order => { %>

<tr>

  <td>#<%= order.id %></td>

  <td><%= order.customer_name || 'N/A' %></td>

  <td><%= order.customer_email || 'N/A' %></td>

  <td>
    <%= order.assigned_staff_name || 'Unassigned' %>
  </td>

  <td>
    <span class="status-badge status-<%= String(order.status || '').toLowerCase() %>">
      <%= order.status %>
    </span>
  </td>

  <td>
    ₱<%= Number(order.total || 0).toFixed(2) %>
  </td>

  <td>
    <%= order.created_at %>
  </td>

  <td>

    <div class="actions">

      <a href="/admin/orders/<%= order.id %>" class="btn btn-small btn-info">
        View
      </a>

      <!-- ASSIGN STAFF -->
      <form method="POST"
            action="/admin/orders/<%= order.id %>/assign">

        <select name="staff_id" required>
          <option value="">Assign Staff</option>

          <% if (typeof staffList !== 'undefined') { %>
            <% staffList.forEach(s => { %>
              <option value="<%= s.id %>"
                <%= order.assigned_staff_id == s.id ? 'selected' : '' %>>
                <%= s.name %>
              </option>
            <% }) %>
          <% } %>

        </select>

        <button class="btn btn-small btn-primary">
          Assign
        </button>

      </form>

      <!-- STATUS -->
      <% if (String(order.status || '').toLowerCase() === 'pending') { %>

        <form method="POST"
              action="/admin/orders/<%= order.id %>/status">

          <input type="hidden" name="status" value="Preparing">

          <button class="btn btn-small btn-success">
            Confirm
          </button>

        </form>

      <% } else if (String(order.status || '').toLowerCase() === 'preparing') { %>

        <form method="POST"
              action="/admin/orders/<%= order.id %>/status">

          <input type="hidden" name="status" value="Completed">

          <button class="btn btn-small btn-primary">
            Complete
          </button>

        </form>

      <% } else { %>

        <button class="btn btn-small btn-secondary" disabled>
          Done
        </button>

      <% } %>

    </div>

  </td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<% } else { %>

<div class="card" style="text-align:center; padding:40px;">
  <h3>No Orders Found</h3>
</div>

<% } %>

</main>

</div>

</body>
</html>