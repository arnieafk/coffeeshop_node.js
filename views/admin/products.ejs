<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Products Management - Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="top-header">
    <div class="left-header">Coffee Shop System</div>
    <button class="menu-toggle" onclick="toggleSidebar()"></button>
    <div class="user-info">
      <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Admin' %></span>
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </header>
  <div class="container">
    <nav class="sidebar" id="sidebar">
      <h2>ADMIN PANEL</h2>
      <p class="menu-title">MAIN</p>
      <a href="/admin">Dashboard</a>
      <a href="/admin/products" class="active">Products</a>
      <a href="/admin/orders">Orders</a>
      <a href="/admin/payments">Payments</a>
      <div class="sidebar-footer">
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </nav>
    <main class="main">
      <div class="header">Products Management</div>
      <div class="card card-actions">
        <a href="/admin/products/new" class="btn btn-primary">Add New Product</a>
        <a href="/admin/orders" class="btn btn-secondary">View Orders</a>
        <a href="/admin/payments" class="btn btn-secondary">View Payments</a>
        <a href="/admin" class="btn btn-secondary">Back to Dashboard</a>
      </div>
      <% if (typeof products !== 'undefined' && products.length > 0) { %>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Price</th>
              <th>Description</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
            <tr>
              <td><strong><%= product.name %></strong></td>
              <td><strong class="text-highlight">$<%= Number(product.price).toFixed(2) %></strong></td>
              <td><%= product.description || 'No description' %></td>
              <td class="actions">
                <a href="/admin/products/<%= product.id %>/edit" class="btn btn-info btn-small">Edit</a>
                <form method="POST" action="/admin/products/<%= product.id %>/delete" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this product?')">
                  <button type="submit" class="btn btn-danger btn-small">Delete</button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="card empty-state">
        <h3>No Products Found</h3>
        <p>Start by adding your first product to your menu.</p>
        <a href="/admin/products/new" class="btn btn-primary">Add First Product</a>
      </div>
      <% } %>
    </main>
  </div>
  <script src="/js/script.js"></script>
</body>
</html>
