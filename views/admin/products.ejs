<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products Management - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top Header Bar -->
  <header class="top-header">
    <div class="user-info">
      <span> Admin Dashboard</span>
    </div>
    <div class="user-info">
      <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Admin' %></span>
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </header>

  <div class="container">
    <!-- Persistent Left Sidebar -->
    <nav class="sidebar">
      <h2> Admin Panel</h2>
      <a href="/admin"> Dashboard</a>
      <a href="/admin/products"> Products</a>
      <a href="/admin/orders"> Orders</a>
      <a href="/admin/payments"> Payments</a>
    </nav>

    <!-- Main Content Area -->
    <main class="main">
      <div class="header">Products Management</div>

      <!-- Quick Actions -->
      <div class="card">
        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
          <a href="/admin/products/new" class="btn btn-primary"> Add New Product</a>
          <a href="/admin/orders" class="btn btn-secondary"> View Orders</a>
          <a href="/admin/payments" class="btn btn-secondary"> View Payments</a>
          <a href="/admin" class="btn btn-secondary"> Back to Dashboard</a>
        </div>
      </div>

      <!-- Products Table -->
      <% if (typeof products !== 'undefined' && products.length > 0) { %>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Description</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(product => { %>
                <tr>
                  <td style="font-weight: 600;"><%= product.name %></td>
                  <td style="font-weight: 600; color: var(--espresso-deep);">$<%= Number(product.price).toFixed(2) %></td>
                  <td><%= product.description || 'No description' %></td>
                  <td class="actions">
                    <a href="/admin/products/<%= product.id %>/edit" class="btn btn-small btn-info">Edit</a>
                    <form method="POST" action="/admin/products/<%= product.id %>/delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this product?')">
                      <button type="submit" class="btn btn-small btn-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="card" style="text-align: center;">
          <div style="font-size: 3rem; margin-bottom: 20px;"></div>
          <h3>No Products Found</h3>
          <p>Start by adding your first product to the menu!</p>
          <a href="/admin/products/new" class="btn btn-primary" style="margin-top: 20px;">Add First Product</a>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
