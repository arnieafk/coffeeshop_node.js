<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Payments Verification - Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>
<header class="top-header">
  <div class="left-header">Coffee Shop System</div>
  <button class="menu-toggle" onclick="toggleSidebar()"></button>
  <div class="user-info">
    <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Admin' %></span>
    <a href="/logout" class="logout-btn">Logout</a>
  </div>
</header>

<div class="container">
  <nav class="sidebar" id="sidebar">
    <h2>ADMIN PANEL</h2>
    <p class="menu-title">MAIN</p>
    <a href="/admin">Dashboard</a>
    <a href="/admin/products">Products</a>
    <a href="/admin/orders">Orders</a>
    <a href="/admin/payments" class="active">Payments</a>
    <div class="sidebar-footer">
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </nav>



    <!-- Main Content -->
    <main class="main">

        <div class="header">
            Payments Verification
        </div>


        <!-- Quick Actions -->
        <div class="card card-actions">
            <a href="/admin/products" class="btn btn-secondary">Products</a>
            <a href="/admin/orders" class="btn btn-secondary">Orders</a>
            <a href="/admin" class="btn btn-secondary">Dashboard</a>
        </div>



        <div class="card">
            <h2>Payment Records</h2>
            <p>View submitted customer payment information and verification statuses.</p>
        </div>



        <% if (payments && payments.length > 0) { %>
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Payment ID</th>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% payments.forEach((p) => { %>
                    <tr>
                        <td><strong>#<%= p.id %></strong></td>
                        <td>ORD-<%= p.order_id %></td>
                        <td><strong><%= p.customer_name %></strong></td>
                        <td>
                            <% if (p.status === 'Pending') { %>
                            <span class="status-badge status-pending">Pending</span>
                            <% } else if (p.status === 'Verified') { %>
                            <span class="status-badge status-completed">Verified</span>
                            <% } else { %>
                            <span class="status-badge status-<%= p.status.toLowerCase() %>"><%= p.status %></span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="card empty-state">
            <h3>No Payments Found</h3>
            <p>There are currently no submitted payments to verify.</p>
            <a href="/admin/orders" class="btn btn-primary">View Orders</a>
        </div>
        <% } %>



        <!-- Payment Stats -->
        <div class="card">
            <h3>Payment Monitoring Tips</h3>
            <ul>
                <li>Check pending payments regularly</li>
                <li>Verify order IDs before approval</li>
                <li>Monitor failed or rejected payments</li>
                <li>Use payment status to track transactions</li>
            </ul>
        </div>


    </main>

</div>
<script src="/js/script.js"></script>
</body>
</html>