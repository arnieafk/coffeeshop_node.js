<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Payments Verification - Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<!-- TOP HEADER -->
<header class="top-header">

  <div class="user-info">
    <span>Admin Dashboard</span>
  </div>

  <div class="user-info">
    <span>
      Welcome,
      <%= typeof user !== 'undefined' ? user.name : 'Admin' %>
    </span>

    <a href="/logout" class="logout-btn">Logout</a>
  </div>

</header>

<div class="container">

  <!-- SIDEBAR -->
  <nav class="sidebar">

    <h2>Admin Panel</h2>

    <p class="menu-title">Main</p>

    <a href="/admin">Dashboard</a>
    <a href="/admin/products">Products</a>
    <a href="/admin/orders">Orders</a>
    <a href="/admin/payments" class="active">Payments</a>
    <a href="/admin/staff">Staff Management</a>

  </nav>

  <!-- MAIN -->
  <main class="main">

    <div class="header">Payments Verification</div>

    <!-- QUICK ACTIONS -->
    <div class="card">
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <a href="/admin/products" class="btn btn-secondary">Products</a>
        <a href="/admin/orders" class="btn btn-secondary">Orders</a>
        <a href="/admin" class="btn btn-secondary">Dashboard</a>
        <a href="/admin/staff" class="btn btn-secondary">Staff Management</a>
      </div>
    </div>

    <!-- DESCRIPTION -->
    <div class="card">
      <h3 style="margin-top:0;">Payment Records</h3>
      <p style="opacity:0.75;">
        Review and verify customer payments for completed orders.
      </p>
    </div>

    <!-- TABLE -->
    <% if (payments && payments.length > 0) { %>

      <div class="table-container">

        <table class="table">

          <thead>
            <tr>
              <th>Payment ID</th>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Status</th>
            </tr>
          </thead>

          <tbody>

            <% payments.forEach(p => { %>

              <tr>

                <td style="font-weight:700;">#<%= p.id %></td>

                <td>ORD-<%= p.order_id %></td>

                <td style="font-weight:600;"><%= p.customer_name %></td>

                <td>

                  <% if (p.status === 'Pending') { %>

                    <span class="status-badge status-pending">
                      Pending
                    </span>

                  <% } else if (p.status === 'Verified') { %>

                    <span class="status-badge status-completed">
                      Verified
                    </span>

                  <% } else { %>

                    <span class="status-badge status-preparing">
                      <%= p.status %>
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } else { %>

      <!-- EMPTY STATE -->
      <div class="card" style="text-align:center; padding:40px;">
        <h3>No Payments Found</h3>
        <p style="opacity:0.7;">
          There are currently no submitted payments.
        </p>

        <a href="/admin/orders" class="btn btn-primary" style="margin-top:15px;">
          View Orders
        </a>
      </div>

    <% } %>

    <!-- FOOT NOTE -->
    <div class="card">
      <h3>Payment Tips</h3>
      <ul style="line-height:1.8; padding-left:20px; opacity:0.85;">
        <li>Always verify order ID before approving</li>
        <li>Check pending payments daily</li>
        <li>Flag suspicious transactions immediately</li>
      </ul>
    </div>

  </main>

</div>

</body>
</html>