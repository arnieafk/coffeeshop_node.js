<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Payments Verification - Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<!-- Top Header -->
<header class="top-header">
    <div class="user-info">
        <span> Admin Dashboard</span>
    </div>

    <div class="user-info">
        <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Admin' %></span>
        <a href="/logout" class="logout-btn">Logout</a>
    </div>
</header>


<div class="container">

    <!-- Sidebar -->
    <nav class="sidebar">
        <h2> Admin Panel</h2>

        <a href="/admin"> Dashboard</a>
        <a href="/admin/products"> Products</a>
        <a href="/admin/orders"> Orders</a>
        <a href="/admin/payments"> Payments</a>
    </nav>



    <!-- Main Content -->
    <main class="main">

        <div class="header">
            Payments Verification
        </div>


        <!-- Quick Actions -->
        <div class="card">
            <div style="display:flex; gap:15px; flex-wrap:wrap;">
                <a href="/admin/products" class="btn btn-secondary">
                     Products
                </a>

                <a href="/admin/orders" class="btn btn-secondary">
                     Orders
                </a>

                <a href="/admin" class="btn btn-secondary">
                     Dashboard
                </a>
            </div>
        </div>



        <!-- Payment Summary -->
        <div class="card">
            <h2 style="margin-bottom:15px;"> Payment Records</h2>
            <p>
                View submitted customer payment information and verification statuses.
            </p>
        </div>



        <!-- Payments Table -->
        <% if (payments && payments.length > 0) { %>

        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Payment ID</th>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                <% payments.forEach((p)=> { %>
                    <tr>
                        <td style="font-weight:600;">
                            #<%= p.id %>
                        </td>

                        <td>
                            ORD-<%= p.order_id %>
                        </td>

                        <td style="font-weight:600;">
                            <%= p.customer_name %>
                        </td>

                        <td>
                            <% if(p.status === 'Pending'){ %>
                                <span style="
                                padding:8px 14px;
                                background:#fff3cd;
                                border-radius:20px;
                                font-weight:600;">
                                Pending
                                </span>

                            <% } else if(p.status === 'Verified'){ %>

                                <span style="
                                padding:8px 14px;
                                background:#d4edda;
                                border-radius:20px;
                                font-weight:600;">
                                 Verified
                                </span>

                            <% } else { %>

                                <span style="
                                padding:8px 14px;
                                background:#f8d7da;
                                border-radius:20px;
                                font-weight:600;">
                                 <%= p.status %>
                                </span>

                            <% } %>
                        </td>
                    </tr>
                <% }) %>

                </tbody>
            </table>
        </div>


        <% } else { %>

        <!-- Empty State -->
        <div class="card" style="text-align:center;">
            <div style="font-size:4rem; margin-bottom:20px;">
                
            </div>

            <h3>No Payments Found</h3>

            <p>
                There are currently no submitted payments to verify.
            </p>

            <a href="/admin/orders"
               class="btn btn-primary"
               style="margin-top:20px;">
               View Orders
            </a>
        </div>

        <% } %>



        <!-- Payment Stats -->
        <div class="card">
            <h3> Payment Monitoring Tips</h3>

            <ul style="line-height:1.8; padding-left:20px;">
                <li>Check pending payments regularly</li>
                <li>Verify order IDs before approval</li>
                <li>Monitor failed or rejected payments</li>
                <li>Use payment status to track transactions</li>
            </ul>
        </div>


    </main>

</div>

</body>
</html>