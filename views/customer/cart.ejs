<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cart - Coffee Shop</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header class="top-header">

  <div class="user-info">
    <span>Coffee Shop</span>
  </div>

  <div class="user-info">
    <span>
      Welcome,
      <%= typeof user !== 'undefined' ? user.name : 'Customer' %>
    </span>

    <a href="/logout" class="logout-btn">Logout</a>
  </div>

</header>

<div class="container">

<nav class="sidebar">

  <h2>Menu</h2>

  <a href="/customer">Dashboard</a>
  <a href="/customer/menu">Browse Menu</a>

  <a href="/customer/cart" class="active">
    Cart
    <% if (cart) { %>
      (<%= cart.length %>)
    <% } %>
  </a>

  <a href="/customer/orders">My Orders</a>

</nav>

<main class="main">

  <div class="header">Your Cart</div>

  <% if (!cart || cart.length === 0) { %>

    <div class="card" style="text-align:center; padding:40px;">
      <h3>Your cart is empty</h3>
      <p style="opacity:0.7;">Add items from the menu.</p>

      <a href="/customer/menu" class="btn btn-primary" style="margin-top:15px;">
        Browse Menu
      </a>
    </div>

  <% } else { %>

    <!-- CART ITEMS -->
    <div class="card">

      <h3 style="margin-top:0;">Cart Items</h3>

      <% cart.forEach(item => { %>

        <div style="
          display:flex;
          justify-content:space-between;
          align-items:center;
          gap:15px;
          padding:15px 0;
          border-bottom:1px solid #eee;
          flex-wrap:wrap;
        ">

          <!-- ITEM INFO -->
          <div style="min-width:160px;">
            <div style="font-weight:700;">
              <%= item.name %>
            </div>

            <div style="opacity:0.7; font-size:0.9rem;">
              ₱<%= Number(item.price).toFixed(2) %> each
            </div>
          </div>

          <!-- QUANTITY -->
          <div style="
            display:flex;
            align-items:center;
            gap:8px;
          ">

            <form method="POST" action="/customer/cart/<%= item.id %>/decrease">
              <button class="btn btn-small btn-secondary" style="width:36px; height:36px;">
                -
              </button>
            </form>

            <span style="
              font-weight:700;
              min-width:25px;
              text-align:center;
            ">
              <%= item.quantity %>
            </span>

            <form method="POST" action="/customer/cart/<%= item.id %>/increase">
              <button class="btn btn-small btn-secondary" style="width:36px; height:36px;">
                +
              </button>
            </form>

          </div>

          <!-- TOTAL -->
          <div style="
            font-weight:700;
            min-width:80px;
            text-align:right;
          ">
            ₱<%= (Number(item.price) * Number(item.quantity)).toFixed(2) %>
          </div>

          <!-- REMOVE -->
          <form method="POST" action="/customer/cart/<%= item.id %>/remove">
            <button class="btn btn-small btn-danger">
              Remove
            </button>
          </form>

        </div>

      <% }) %>

    </div>

    <!-- TOTAL -->
    <div class="card">

      <div style="
        display:flex;
        justify-content:space-between;
        flex-wrap:wrap;
        gap:10px;
        margin-bottom:15px;
      ">

        <div style="font-size:1rem;">
          Total Items:
          <strong>
            <%= cart.reduce((sum, item) => sum + item.quantity, 0) %>
          </strong>
        </div>

        <div style="font-size:1.3rem; font-weight:800;">
          Total:
          ₱<%= typeof total !== 'undefined' ? total.toFixed(2) : '0.00' %>
        </div>

      </div>

      <form method="POST" action="/customer/orders/place">

        <button class="btn btn-primary" style="width:100%; padding:14px;">
          Place Order
        </button>

      </form>

    </div>

    <div style="text-align:center;">
      <a href="/customer/menu" class="btn btn-secondary">
        Continue Shopping
      </a>
    </div>

  <% } %>

</main>

</div>

</body>
</html>