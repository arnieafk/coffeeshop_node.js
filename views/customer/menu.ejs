<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Menu - Coffee Shop</title>
<link rel="stylesheet" href="/css/style.css">

<style>
/* ===== PRODUCT GRID FIX (UI ONLY) ===== */
.products-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:20px;
  margin-top:20px;
}

/* PRODUCT CARD */
.product-card{
  background: rgba(255,255,255,0.9);
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 10px 25px rgba(0,0,0,0.08);
  transition:0.25s ease;
  display:flex;
  flex-direction:column;
}

.product-card:hover{
  transform:translateY(-6px);
  box-shadow:0 18px 40px rgba(0,0,0,0.12);
}

/* IMAGE AREA */
.product-image{
  height:220px;
  overflow:hidden;
  background:#f5f5f5;
}

/* INFO */
.product-info{
  padding:15px;
  display:flex;
  flex-direction:column;
  gap:8px;
}

.product-name{
  font-size:1.1rem;
  font-weight:800;
  color:var(--espresso-deep);
}

.product-description{
  font-size:0.85rem;
  opacity:0.75;
  line-height:1.4;
  min-height:40px;
}

.product-price{
  font-size:1rem;
  font-weight:800;
  color:var(--espresso-deep);
  margin-top:5px;
}

/* BUTTON AREA */
.product-actions{
  margin-top:auto;
}
</style>

</head>
<body>

<header class="top-header">

  <div class="user-info">
    <span>Coffee Shop</span>
  </div>

  <div class="user-info">

    <span>
      Welcome,
      <%= typeof user !== 'undefined'
        ? user.name
        : 'Customer' %>
    </span>

    <a href="/logout" class="logout-btn">Logout</a>

  </div>

</header>

<div class="container">

<nav class="sidebar">

  <h2>Customer Panel</h2>

  <p class="menu-title">Main Navigation</p>

  <a href="/customer">Dashboard</a>

  <a href="/customer/menu" class="active">Browse Menu</a>

  <a href="/customer/cart">
    Cart
    <% if (typeof cart !== 'undefined') { %>
      (<%= cart.length %>)
    <% } %>
  </a>

  <a href="/customer/orders">My Orders</a>

</nav>

<main class="main">

  <div class="header">Our Menu</div>

  <div class="card">
    <p style="margin:0; line-height:1.8;">
      Discover our handcrafted coffee, refreshing beverages,
      and freshly prepared snacks made for every customer.
    </p>
  </div>

  <% if (typeof products !== 'undefined' && products.length > 0) { %>

    <div class="products-grid">

      <% products.forEach(product => { %>

        <div class="product-card">

          <!-- IMAGE -->
          <div class="product-image">

            <% if (product.image) { %>

              <img
                src="<%= product.image %>"
                alt="<%= product.name %>"
                style="width:100%;height:100%;object-fit:cover;"
              >

            <% } else { %>

              <div style="
                height:100%;
                display:flex;
                align-items:center;
                justify-content:center;
                color:#888;
                font-size:0.9rem;
              ">
                No Image Available
              </div>

            <% } %>

          </div>

          <!-- INFO -->
          <div class="product-info">

            <div class="product-name">
              <%= product.name %>
            </div>

            <div class="product-description">
              <%= product.description &&
                product.description.trim() !== ''
                ? product.description
                : 'Freshly prepared using quality ingredients.'
              %>
            </div>

            <div class="product-price">
              ₱<%= Number(product.price).toFixed(2) %>
            </div>

            <div class="product-actions">

              <form method="POST" action="/customer/menu/<%= product.id %>/add">

                <button class="btn btn-primary" style="width:100%;">
                  Add to Cart
                </button>

              </form>

            </div>

          </div>

        </div>

      <% }); %>

    </div>

  <% } else { %>

    <div class="card" style="text-align:center;">
      <h3>No Items Available</h3>
      <p>No products are currently available in the menu.</p>
      <a href="/customer" class="btn btn-primary">Back to Dashboard</a>
    </div>

  <% } %>

</main>

</div>

</body>
</html>