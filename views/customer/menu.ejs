<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Menu - Coffee Shop</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="top-header">
    <div class="left-header">Coffee Shop System</div>
    <button class="menu-toggle" onclick="toggleSidebar()"></button>
    <div class="user-info">
      <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Customer' %></span>
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </header>
  <div class="container">
    <nav class="sidebar" id="sidebar">
      <h2>CUSTOMER PANEL</h2>
      <p class="menu-title">MAIN</p>
      <a href="/customer">Dashboard</a>
      <a href="/customer/menu">Browse Menu</a>
      <a href="/customer/cart">Cart<% if (typeof cart !== 'undefined' && cart.length) { %> (<%= cart.length %>)<% } %></a>
      <a href="/customer/orders">My Orders</a>
      <div class="sidebar-footer">
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </nav>
    <main class="main">
      <div class="header">Our Menu</div>
      <div class="section-intro">
        <p>Discover a carefully curated selection of premium coffee, fresh pastries, and delightful treats. Add items to your cart and place your order with confidence.</p>
      </div>
      <% if (typeof products !== 'undefined' && products.length > 0) { %>
      <div class="product-grid">
        <% products.forEach(product => { %>
        <div class="product-card">
          <div class="product-image"></div>
          <div class="product-info">
            <div class="product-name"><%= product.name %></div>
            <div class="product-description"><%= product.description && product.description.trim() !== '' ? product.description : 'Freshly prepared using premium ingredients.' %></div>
            <div class="product-price">$<%= Number(product.price).toFixed(2) %></div>
            <div class="product-actions">
              <form method="POST" action="/customer/menu/<%= product.id %>/add">
                <button type="submit" class="btn btn-primary btn-full">Add to Cart</button>
              </form>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div class="card empty-state">
        <h3>No Items Available</h3>
        <p>We are updating the menu with new coffee and snacks. Please check back soon.</p>
        <a href="/customer" class="btn btn-primary">Back to Dashboard</a>
      </div>
      <% } %>
    </main>
  </div>
  <script src="/js/script.js"></script>
</body>
</html>
