<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Orders - Coffee Shop</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="top-header">
    <div class="left-header">Coffee Shop System</div>
    <button class="menu-toggle" onclick="toggleSidebar()"></button>
    <div class="user-info">
      <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Customer' %></span>
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </header>
  <div class="container">
    <nav class="sidebar" id="sidebar">
      <h2>CUSTOMER PANEL</h2>
      <p class="menu-title">MAIN</p>
      <a href="/customer">Dashboard</a>
      <a href="/customer/menu">Browse Menu</a>
      <a href="/customer/cart">Cart<% if (typeof cartCount !== 'undefined' && cartCount > 0) { %> (<%= cartCount %>)<% } %></a>
      <a href="/customer/orders">My Orders</a>
      <div class="sidebar-footer">
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </nav>
    <main class="main">
      <div class="header">My Orders</div>
      <% if (typeof orders === 'undefined' || !orders.length) { %>
      <div class="card empty-state">
        <h3>No orders yet</h3>
        <p>You haven't placed any orders yet. Start by browsing our delicious menu.</p>
        <a href="/customer/menu" class="btn btn-primary">Browse Menu</a>
      </div>
      <% } else { %>
      <% orders.forEach(order => { %>
      <div class="order-card">
        <div class="order-card-header order-summary">
          <div class="order-details">
            <h3>Order #<%= order.id %></h3>
            <p class="order-meta"><%= formatManilaDateTime(order.created_at) %></p>
          </div>
          <div class="order-details order-total">
            <div class="order-highlight">$<%= Number(order.total).toFixed(2) %></div>
            <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
          </div>
        </div>
        <div class="order-card-items">
          <h4 class="order-section-title">Order Items</h4>
          <% order.items.forEach(item => { %>
          <div class="order-card-item order-item-row">
            <div class="order-item-row">
              <div class="order-item-avatar"><%= item.image || '' %></div>
              <div class="order-item-info">
                <div class="order-item-name"><%= item.name %></div>
                <div class="order-meta">Quantity: <%= item.quantity %></div>
              </div>
            </div>
            <div class="order-item-price">$<%= (Number(item.price) * Number(item.quantity)).toFixed(2) %></div>
          </div>
          <% }); %>
        </div>
        <div class="status-steps">
          <div class="status-step <%= order.status === 'Pending' ? 'active' : '' %>">Order Placed</div>
          <div class="status-step <%= order.status === 'Preparing' ? 'active' : '' %>">Preparing</div>
          <div class="status-step <%= order.status === 'Completed' ? 'active' : '' %>">Completed</div>
        </div>
      </div>
      <% }); %>
      <div class="card-actions">
        <a href="/customer/menu" class="btn btn-secondary">Order More Items</a>
      </div>
      <% } %>
    </main>
  </div>
  <script src="/js/script.js"></script>
