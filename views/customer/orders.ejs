<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders - Coffee Shop</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top Header Bar -->
  <header class="top-header">
    <div class="user-info">
      <span>☕ Coffee Shop</span>
    </div>
    <div class="user-info">
      <span>Welcome, <%= typeof user !== 'undefined' ? user.name : 'Customer' %></span>
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </header>

  <div class="container">
    <!-- Persistent Left Sidebar -->
    <nav class="sidebar">
      <h2>☕ Menu</h2>
      <a href="/customer">🏠 Dashboard</a>
      <a href="/customer/menu">📖 Browse Menu</a>
      <a href="/customer/cart">🛒 Cart <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>(<%= cartCount %>)<% } %></a>
      <a href="/customer/orders">📋 My Orders</a>
    </nav>

    <!-- Main Content Area -->
    <main class="main">
      <div class="header">My Orders</div>

      <% if (typeof orders === 'undefined' || !orders.length) { %>
        <div class="card" style="text-align: center;">
          <div style="font-size: 4rem; margin-bottom: 20px;">📋</div>
          <h3>No orders yet</h3>
          <p>You haven't placed any orders. Start by browsing our delicious menu!</p>
          <a href="/customer/menu" class="btn btn-primary" style="margin-top: 20px;">Browse Menu</a>
        </div>
      <% } else { %>
        <% orders.forEach(order => { %>
          <div class="card" style="margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
              <div>
                <h3 style="margin: 0;">Order #<%= order.id %></h3>
                <p style="margin: 5px 0; color: var(--text-main); opacity: 0.8;">
                  <%= formatManilaDateTime(order.created_at) %>
                </p>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 1.3rem; font-weight: 700; color: var(--espresso-deep); margin-bottom: 8px;">
                  $<%= Number(order.total).toFixed(2) %>
                </div>
                <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
              </div>
            </div>

            <!-- Order Items -->
            <div style="margin-bottom: 20px;">
              <h4 style="margin-bottom: 15px; color: var(--espresso-deep);">Order Items:</h4>
              <% order.items.forEach(item => { %>
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(0,0,0,0.1);">
                  <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="width: 50px; height: 50px; background: var(--latte-accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                      <%= item.image || '☕' %>
                    </div>
                    <div>
                      <div style="font-weight: 600; color: var(--espresso-deep);"><%= item.name %></div>
                      <div style="font-size: 0.9rem; color: var(--text-main); opacity: 0.8;">Quantity: <%= item.quantity %></div>
                    </div>
                  </div>
                  <div style="font-weight: 600; color: var(--espresso-deep);">
                    $<%= (Number(item.price) * Number(item.quantity)).toFixed(2) %>
                  </div>
                </div>
              <% }); %>
            </div>

            <!-- Order Status Timeline -->
            <div style="background: rgba(215, 184, 153, 0.1); padding: 15px; border-radius: 8px;">
              <h4 style="margin: 0 0 10px 0; color: var(--espresso-deep);">Order Status</h4>
              <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <%
                  const pendingColor = (order.status === 'pending' || order.status === 'preparing' || order.status === 'completed') ? '#28a745' : '#6c757d';
                  const preparingColor = (order.status === 'preparing' || order.status === 'completed') ? '#28a745' : '#6c757d';
                  const completedColor = order.status === 'completed' ? '#28a745' : '#6c757d';
                %>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <div style="width: 12px; height: 12px; border-radius: 50%;" data-color="<%= pendingColor %>"></div>
                  <span style="font-size: 0.9rem;">Order Placed</span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <div style="width: 12px; height: 12px; border-radius: 50%;" data-color="<%= preparingColor %>"></div>
                  <span style="font-size: 0.9rem;">Preparing</span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <div style="width: 12px; height: 12px; border-radius: 50%;" data-color="<%= completedColor %>"></div>
                  <span style="font-size: 0.9rem;">Ready for Pickup</span>
                </div>
              </div>
            </div>
          </div>
        <% }); %>

        <div style="text-align: center; margin-top: 30px;">
          <a href="/customer/menu" class="btn btn-secondary">Order More Items</a>
        </div>
      <% } %>
    </main>
  </div>
  <script>
    document.querySelectorAll('[data-color]').forEach(el => {
      el.style.backgroundColor = el.getAttribute('data-color');
    });
  </script>
</body>
</html>
